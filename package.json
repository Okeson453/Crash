{
  "name": "bc-game-crash-automation",
  "version": "1.1.0",
  "description": "CrashWave V1.1 \u2014 multi-worker adaptive crash automation platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:simulation": "jest --testPathPattern=tests/simulation",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests scripts --ext .ts",
    "lint:fix": "eslint src tests scripts --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:backup": "bash scripts/backup-db.sh",
    "security:audit": "npm audit --audit-level=moderate",
    "generate-key": "tsx scripts/generate-encryption-key.ts",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f app",
    "dev:control-plane": "PLATFORM_MODE=control-plane tsx src/index.ts",
    "start:control-plane": "PROCESS_ROLE=control-plane node dist/index.js",
    "watchdog:capital": "tsx scripts/capital-watchdog.ts",
    "test:unit:spec": "jest tests/unit/capital tests/unit/protocol tests/unit/risk tests/unit/network tests/unit/core tests/unit/settlement --passWithNoTests",
    "db:migrate:ts": "tsx scripts/db-migrate.ts",
    "test:load": "tsx scripts/load-test-500.ts",
    "test:load:burst": "tsx scripts/load-test-500.ts --burst",
    "credentials:import": "tsx scripts/import-tenant-credentials.ts",
    "typecheck:all": "tsc --noEmit",
    "verify:phase5": "node scripts/phase5-verification.mjs",
    "test:security": "jest --testPathPattern=tests/unit/security --passWithNoTests",
    "test:referrals": "jest --testPathPattern=tests/unit/referrals --passWithNoTests",
    "bench:prediction": "node scripts/prediction-perf-bench.mjs",
    "validate:randomness": "node -e \"console.log('Use runRandomnessGate from app with \u226550k rounds')\"",
    "start:automation": "PROCESS_ROLE=automation-worker node dist/index.js",
    "start:mini-game": "PROCESS_ROLE=mini-app-game node dist/index.js",
    "start:monolith": "PROCESS_ROLE=all node dist/index.js"
  },
  "keywords": [
    "automation",
    "analytics",
    "crash-game",
    "playwright",
    "typescript"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "socket.io": "^4.7.5",
    "jose": "^5.6.3",
    "ioredis": "^5.4.1",
    "js-yaml": "^4.1.0",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "playwright": "1.62.1",
    "prom-client": "^15.1.3",
    "telegraf": "^4.16.3",
    "ws": "^8.21.3",
    "zod": "^3.23.8",
    "typescript": "^5.9.3",
    "@fastify/helmet": "^11.1.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.17.0"
  },
  "optionalDependencies": {
    "@fastify/helmet": "^11.1.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@socket.io/redis-adapter": "^8.3.0"
  }
}
