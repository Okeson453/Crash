# BC.Game Crash Automation — environment template
# Copy to .env and fill in secrets. Never commit real credentials.

# --- Core --------------------------------------------------------------------
APP_SYSTEM__MODE=dry-run
APP_SYSTEM__LOG_LEVEL=info
NODE_ENV=production

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# APP_TELEGRAM__ALLOWED_USER_IDS=[123456789]

# --- Database / Redis --------------------------------------------------------
DATABASE_URL=postgresql://user:pass@host:5432/crash
REDIS_URL=redis://host:6379

# --- Secrets -----------------------------------------------------------------
ENCRYPTION_KEY=
TENANT_MASTER_KEY=
ADMIN_API_TOKEN=

# --- Playwright --------------------------------------------------------------
# BROWSER_HEADLESS=true
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# --- Residential / ISP proxy (Webshare / Bright Data / etc.) ------------------
# Enable with a quality residential/ISP provider. Sticky session recommended.
# Single proxy:
#   APP_PROXY__ENABLED=true
#   APP_PROXY__SERVER=http://31.59.20.176:6754
#   APP_PROXY__USERNAME=OkesonProxy
#   APP_PROXY__PASSWORD=Peace1man2
#   APP_PROXY__PROVIDER=webshare
#   APP_PROXY__STICKY=true
#   APP_PROXY__ROTATION_MODE=never
# Pool (Webshare host:port:user:pass, JSON array or newline-separated):
#   APP_PROXY__ENABLED=true
#   APP_PROXY__PROVIDER=webshare
#   APP_PROXY__POOL=["31.59.20.176:6754:OkesonProxy:Peace1man2","45.38.107.97:6014:OkesonProxy:Peace1man2"]
# Prefer UK endpoints for BC.Game region access when available.
APP_PROXY__ENABLED=false
APP_PROXY__STICKY=true
APP_PROXY__ROTATION_MODE=never
APP_PROXY__PROVIDER=generic

# --- Velocity / behavioral ---------------------------------------------------
# APP_VELOCITY__ENABLED=true
# APP_BEHAVIORAL__ENABLED=true

# --- Live execution gate -----------------------------------------------------
# ALLOW_REAL_EXECUTION=false

# --- Paystack (optional in dry-run) ------------------------------------------
# PAYSTACK_SECRET_KEY=
# PAYSTACK_OPTIONAL=true

# Production security
TENANT_SECRET_DIR=/run/crashwave/secrets
TENANT_DOCKER_NETWORK=crashwave_tenants
CREDENTIAL_ENROLLMENT_MODE=operator
